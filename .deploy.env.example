# Copy to .deploy.env (git-ignored) and fill in. Values stay on your machine, never in the repo.
DEPLOY_HOST=            # server host name or IP of the German hosting
DEPLOY_USER=            # SSH user
DEPLOY_PORT=22
DEPLOY_KEY=             # path to the SSH private key, e.g. ~/.ssh/id_ed25519_radar_de
DEPLOY_ROOT=            # remote base dir, e.g. /home/<user>/radar-de  (releases/ and current -> are created inside)
KEEP_RELEASES=5
