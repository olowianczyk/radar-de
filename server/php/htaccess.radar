# .htaccess of the docroot (deployed from server/php/htaccess.radar).
# Layout on the server:  <docroot>/index.html, app/, assets/ (static frontend)
#                        <docroot>/api/index.php (+ i18n.php, sources*.json) (PHP port)
# Data and secrets live OUTSIDE the docroot (~/private/...), never here.

RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# --- 1. Deny what must never be served ------------------------------------
# Hidden files and folders (.git, .env, .htpasswd, .deploy.env ...). The
# ACME challenge folder stays reachable for certificate renewal.
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
# Documentation, tests, fixtures and scripts are repo material, not site content.
RewriteRule ^(docs|tests|scripts|server|node_modules)(/|$) - [F,L]
# JSON files (sources.de.json, sources.json, any stray data) — the frontend
# reads data only through /api/<route>, never as a static .json URL.
RewriteRule \.json$ - [F,L]
# PHP: only the entry point may be requested. i18n.php, test-*.php, smtp*.php
# and friends are includes / CLI tools, so a direct hit is refused.
RewriteRule ^api/index\.php$ - [L]
RewriteRule \.php$ - [F,L]

# --- 2. API routes -> the single PHP entry point -----------------------------
# Keep this list in sync with the `switch ($route)` in server/php/index.php.
RewriteRule ^api/(state|kb|keywords|sources|triage|scan|scan-all|notify|watch)$ api/index.php?r=$1 [L,QSA]

# --- 3. Headers (needs mod_headers; ignored silently where it is absent) -------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>
